# ==============================================================================
# Blind Report — Vercel / Next.js Frontend Environment Variables
# ==============================================================================

# --- Public Client Variables (Exposed to the Browser) ---

# Ethereum Sepolia RPC URL (fallback: https://ethereum-sepolia-rpc.publicnode.com)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Blind Report Relayer backend URL (fallback: http://127.0.0.1:8787 for local dev)
# If your Relayer is deployed, configure its HTTPS endpoint here:
NEXT_PUBLIC_RELAYER_URL=http://127.0.0.1:8787

# --- World ID / Serverless RP Context Variables (Used by /api/rp-context) ---

# World ID App ID from World Developer Portal
WORLD_APP_ID=app_4042c24254a33097907e995869d6e132

# Relying Party Identifier
WORLD_RP_ID=rp_4847560e061aacf6

# Secret RP Context Signing Key (Hex)
RP_SIGNING_KEY=0x2642d13ff032c4a68ce7a4c30e7d5215a4bb700c96eb2a7a8df124c8779240c8

# World ID Environment: 'staging' or 'production'
WORLD_ENVIRONMENT=staging
