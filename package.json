{
  "name": "blind-report",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Blind Report — canal de denúncia anônima para jornalismo (ENSv2 + Arkiv + World ID).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "WEBSITE"
  ],
  "scripts": {
    "build": "npm --prefix WEBSITE run build",
    "guardrails": "node guardrails/check.mjs",
    "test:guardrails": "node --test guardrails/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run guardrails && npm run test:guardrails && npm run typecheck && npm run test:coverage",
    "nodes:up": "bash tests/fixtures/nodes-up.sh",
    "nodes:down": "bash tests/fixtures/nodes-down.sh",
    "validation": "tsx",
    "test:integration": "bash tests/run-integration.sh",
    "test:e2e": "bash tests/run-e2e.sh",
    "test:partners": "vitest run tests/e2e/partner-prizes.test.ts",
    "test:e2e:frontend": "vitest run tests/e2e/website-frontend.test.ts",
    "test:e2e:full": "vitest run tests/e2e/full-stack-frontend-onchain.test.ts",
    "test:frontend:sepolia": "node --env-file-if-exists=.env --import tsx scripts/test-e2e-frontend-sepolia.ts",
    "test:sepolia": "node --env-file-if-exists=.env --import tsx scripts/test-sepolia.ts",
    "test:sepolia:flow": "node --env-file-if-exists=.env --import tsx scripts/test-e2e-sepolia.ts",
    "test:live": "node --env-file-if-exists=.env node_modules/.bin/vitest run -c vitest.live.config.ts",
    "relayer": "node --env-file=.env --import tsx apps/relayer/src/main.ts",
    "demo": "node --import tsx scripts/demo-flow.ts",
    "test:all": "bash scripts/test-all.sh",
    "dev": "bash scripts/start-dev.sh",
    "dev:all": "bash scripts/start-dev.sh",
    "web": "npm --prefix WEBSITE run dev",
    "web:dev": "npm --prefix WEBSITE run dev",
    "web:build": "npm --prefix WEBSITE run build",
    "web:start": "npm --prefix WEBSITE run start",
    "links": "node --env-file=.env scripts/links.mjs",
    "keys:generate": "node scripts/generate-keys.mjs",
    "arkiv:query": "node --env-file-if-exists=.env --import tsx arkiv/query.ts",
    "website:install": "npm --prefix WEBSITE install",
    "website:dev": "npm --prefix WEBSITE run dev",
    "website:build": "npm --prefix WEBSITE run build",
    "website:start": "npm --prefix WEBSITE run start",
    "website:test": "vitest run WEBSITE/test",
    "test:website": "vitest run WEBSITE/test"
  },
  "devDependencies": {
    "@arkiv-network/sdk": "^1.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@worldcoin/idkit-core": "^4.6.0",
    "esbuild": "^0.25.12",
    "fast-check": "^3.23.0",
    "magic-string": "0.30.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "viem": "^2.57.14",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@tailwindcss/node": {
      "magic-string": "0.30.17"
    },
    "magic-string": "0.30.17"
  }
}
