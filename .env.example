# Copie para .env (que está no .gitignore). SOMENTE testnet, carteiras novas, nunca com dinheiro real.

# Carteiras de teste (chaves privadas: SEGREDO)
OWNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
JOURNALIST_PRIVATE_KEY=

# Endereços (públicos)
OWNER_ADDRESS=
RELAYER_ADDRESS=
JOURNALIST_ADDRESS=

# Arkiv (Rabdi): chave de acesso do Hub (SEGREDO)
ARKIV_ACCESS_KEY=

# World ID (Developer Portal): rp_id e app_id são identificadores; a chave de assinatura é SEGREDO
WORLD_APP_ID=app_4042c24254a33097907e995869d6e132
WORLD_RP_ID=rp_4847560e061aacf6
RP_SIGNING_KEY=0x2642d13ff032c4a68ce7a4c30e7d5215a4bb700c96eb2a7a8df124c8779240c8
WORLD_ENVIRONMENT=staging

# Rede (RPC público comum; configurável)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network

# Relayer / app runtime
PORT=8787
HOST=127.0.0.1
NEWSROOMS=jornal-livre.eth
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005
RATE_LIMIT_PER_MINUTE=120
NULLIFIER_FILE=data/claims.jsonl
SIMULATE_WORLD=0
RETENTION_DAYS=150
RENEW_WITHIN_DAYS=60
MAX_BODY_BYTES=1048576

# Regras do MVP
EPOCH_PERIOD=monthly
